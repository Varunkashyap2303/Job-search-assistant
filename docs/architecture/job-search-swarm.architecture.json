  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Scout runs every 2h; Sonnet scores newest-first (~$0.007 a job)",
        "Opus writes a fact-cited resume (~$0.10-0.14)",
        "You approve; answers are drafted and the form pre-filled"
      ]
    },
    {
      "dot": "violet",
      "title": "Claude and state",
      "items": [
        "llm.parse() is the job search's only path to Anthropic",
        "Capped per agent, per day ($1.50) and per month",
        "Hermes uses its own key, outside that budget guard"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Job ads, news and sites are data, never instructions",
        "Hermes on Telegram: job-search tools only, no shell or files",
        "Nothing is sent or submitted without your click"
      ]
    }
