# Copy to .env and fill in. Never commit .env.

# Required: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only needed if your key isn't scoped to a workspace (Console -> Settings -> Workspaces, id looks like wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# Optional free job APIs (sources are skipped when blank)
# Adzuna: register at https://developer.adzuna.com/ (free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: request a key at https://jooble.org/api/about (free)
JOOBLE_API_KEY=

# Optional: force the browser used for PDFs and form filling (default tries msedge, then chrome, then chromium)
JOBSEARCH_BROWSER=
